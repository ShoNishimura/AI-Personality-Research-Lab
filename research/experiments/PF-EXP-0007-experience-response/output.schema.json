{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "intensity", "latency"],
  "properties": {
    "action": {"type": "string", "minLength": 1, "maxLength": 400},
    "intensity": {"type": "integer", "minimum": 0, "maximum": 4},
    "latency": {"type": "integer", "minimum": 0, "maximum": 4}
  }
}
